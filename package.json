{
  "name": "@argszero/cordis-plugin-length-stop-overflow",
  "description": "Length-stop overflow guard for dsh: observes the llm/stream waterfall and reclassifies a max-tokens finish whose output count is negligible. A provider (or pi-ai's own context clamp) that truncates an over-long request answers finish_reason 'length'; the harness reads that as an ordinary output cap, so agent/request-error never sees CONTEXT_WINDOW_EXCEEDED and the context-overflow recovery never runs - the session answers 'continue' with one token forever. Compatible with every prerelease line from 0.1.3-alpha.2 onward (0.1.3/0.1.5/0.1.6).",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "plugin",
    "guard",
    "context-overflow",
    "compaction",
    "max-tokens",
    "length",
    "finish_reason",
    "truncation",
    "pi-ai"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.3-alpha.2 <0.1.4 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-alpha.1 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "typescript": "^5.5.0",
    "@deepseek-ai/dsh-invariants": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.6-alpha.2"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"test/*.test.js\"",
    "prepublishOnly": "tsc"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": false
    }
  }
}
